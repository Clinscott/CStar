{
  "contract": "cstar.core.v1",
  "states": [
    "constructed",
    "submitted",
    "observed",
    "disposed"
  ],
  "events": [
    "construct",
    "submit",
    "observe",
    "dispose"
  ],
  "rejection": "invalid_transition",
  "rules": {
    "no_state_is_unconstructed": true,
    "all_unlisted_pairs_reject": true,
    "rejection_preserves_caller_state": true,
    "run_each_vector_twice": true,
    "result_bytes": "exact ASCII JSON plus one LF from result_canonical"
  },
  "vectors": [
    {
      "id": "construct",
      "prior": null,
      "event": "construct",
      "result_canonical": "{\"accepted\":\"constructed\"}\n"
    },
    {
      "id": "submit",
      "prior": "constructed",
      "event": "submit",
      "result_canonical": "{\"accepted\":\"submitted\"}\n"
    },
    {
      "id": "observe",
      "prior": "submitted",
      "event": "observe",
      "result_canonical": "{\"accepted\":\"observed\"}\n"
    },
    {
      "id": "dispose-observed",
      "prior": "observed",
      "event": "dispose",
      "result_canonical": "{\"accepted\":\"disposed\"}\n"
    },
    {
      "id": "dispose-before-submit",
      "prior": "constructed",
      "event": "dispose",
      "result_canonical": "{\"accepted\":\"disposed\"}\n"
    },
    {
      "id": "reject-submit-without-state",
      "prior": null,
      "event": "submit",
      "result_canonical": "{\"rejected\":\"invalid_transition\"}\n"
    },
    {
      "id": "reject-observe-before-submit",
      "prior": "constructed",
      "event": "observe",
      "result_canonical": "{\"rejected\":\"invalid_transition\"}\n"
    },
    {
      "id": "reject-terminal-reuse",
      "prior": "disposed",
      "event": "construct",
      "result_canonical": "{\"rejected\":\"invalid_transition\"}\n"
    }
  ]
}
