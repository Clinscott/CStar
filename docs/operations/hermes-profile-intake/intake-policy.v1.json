{
  "schema_version": "hermes.profile.intake.policy.v1",
  "mode": "metadata_only_first_pass",
  "source_root_representation": "placeholder_or_alias_only",
  "candidate_roots": [
    "SKILL.md",
    "SOUL.md",
    "skills/",
    "scripts/",
    "tests/",
    "prompts/",
    "schemas/",
    "templates/"
  ],
  "optional_candidate_root_alias": "OPERATOR_APPROVED_RELATIVE_SOURCE_ROOT",
  "automatic_candidate_kinds": [
    "source",
    "skill_contract",
    "test",
    "schema",
    "template",
    "documentation",
    "dependency_manifest",
    "config_example"
  ],
  "manual_review_patterns": [
    "SOUL.md",
    "**/prompts/**",
    "**/fixtures/**",
    "**/*.example.*",
    "**/*.sample.*"
  ],
  "hard_exclusion_categories": [
    "secrets",
    "oauth_state",
    "sessions_and_cookies",
    "logs_and_transcripts",
    "memories_and_personal_context",
    "raw_vaults_and_private_data",
    "databases_and_caches",
    "runtime_state",
    "live_configuration",
    "cron_state",
    "generated_artifacts"
  ],
  "pruned_directory_names": [
    ".git",
    ".cache",
    "__pycache__",
    "node_modules",
    "logs",
    "log",
    "sessions",
    "session",
    "cookies",
    "browser-profile",
    "memory",
    "memories",
    "raw",
    "sources",
    "dossiers",
    "knowledge",
    "notes",
    "decisions",
    "queue",
    "runs",
    "health",
    "ops",
    "wiki",
    "indexes",
    "backups",
    ".backups",
    "vault",
    "secrets",
    "credentials",
    "oauth"
  ],
  "excluded_file_name_patterns": [
    ".env",
    ".env.*",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*secret*",
    "*credential*",
    "*oauth*",
    "*token*",
    "*cookie*",
    "*session*",
    "*.log",
    "*.db",
    "*.sqlite",
    "*.sqlite3",
    "*.pid",
    "*.lock"
  ],
  "first_pass_allowed_metadata": [
    "normalized_relative_path",
    "size_bytes",
    "modified_epoch",
    "profile_kind",
    "asset_kind",
    "review_status"
  ],
  "first_pass_forbidden_fields": [
    "content",
    "absolute_path",
    "source_text",
    "secret_hash",
    "excluded_file_path",
    "oauth_reference",
    "session_identifier"
  ],
  "bundle_gate": {
    "operator_candidate_approval_required": true,
    "secret_and_private_data_scan_required": true,
    "manual_review_required_for_prompts_fixtures_soul_and_config_examples": true,
    "archive_before_approval_allowed": false,
    "commit_before_approval_allowed": false,
    "upload_before_approval_allowed": false
  }
}
