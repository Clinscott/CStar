{
  "schema_version": "hermes.profile.intake.policy.v1",
  "mode": "metadata_only_first_pass",
  "compatibility_lane": "legacy_v2_only",
  "current_host_transport": "codex-host",
  "current_runtime_integration": false,
  "mm_status": "inactive",
  "source_root_representation": "alias_only",
  "profile_kinds": [
    "forge",
    "researcher"
  ],
  "source_root_aliases": {
    "forge": "HERMES_FORGE_PROFILE_ROOT",
    "researcher": "HERMES_RESEARCHER_PROFILE_ROOT"
  },
  "candidate_roots": [
    "SKILL.md",
    "SOUL.md",
    "skills/",
    "src/",
    "scripts/",
    "tests/",
    "prompts/",
    "schemas/",
    "templates/"
  ],
  "automatic_candidate_kinds": [
    "source",
    "skill_contract",
    "test",
    "schema",
    "template",
    "documentation",
    "dependency_manifest",
    "config_example"
  ],
  "manual_review_patterns": [
    "SOUL.md",
    "**/prompts/**",
    "**/fixtures/**",
    "**/*.example.*",
    "**/*.sample.*"
  ],
  "hard_exclusion_categories": [
    "profile_contents",
    "oauth_state",
    "tokens",
    "credentials",
    "secrets",
    "commands",
    "endpoints",
    "logs",
    "transcripts_and_traces",
    "sessions",
    "cookies_and_browser_state",
    "databases",
    "caches",
    "runtime_state",
    "local_secret_paths",
    "live_configuration",
    "memories_and_personal_context",
    "raw_vaults_and_private_data",
    "generated_artifacts"
  ],
  "pruned_directory_names": [
    ".git",
    ".cache",
    "__pycache__",
    "node_modules",
    "logs",
    "log",
    "sessions",
    "session",
    "cookies",
    "browser-profile",
    "memory",
    "memories",
    "raw",
    "sources",
    "dossiers",
    "knowledge",
    "notes",
    "decisions",
    "queue",
    "runs",
    "health",
    "ops",
    "wiki",
    "indexes",
    "backups",
    ".backups",
    "vault",
    "secrets",
    "credentials",
    "oauth"
  ],
  "excluded_file_name_patterns": [
    ".env",
    ".env.*",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*secret*",
    "*credential*",
    "*oauth*",
    "*token*",
    "*cookie*",
    "*session*",
    "*.log",
    "*.db",
    "*.sqlite",
    "*.sqlite3",
    "*.pid",
    "*.lock"
  ],
  "first_pass_allowed_metadata": [
    "relative_path",
    "size_bytes",
    "modified_epoch",
    "profile_kind",
    "asset_kind",
    "review_status"
  ],
  "first_pass_forbidden_fields": [
    "content",
    "profile_content",
    "source_text",
    "prompt_body",
    "configuration_body",
    "oauth_state",
    "access_token",
    "refresh_token",
    "token",
    "credential",
    "secret",
    "command",
    "command_arguments",
    "endpoint",
    "network_target",
    "log",
    "transcript",
    "trace",
    "session",
    "cookie",
    "database",
    "cache",
    "runtime_state",
    "absolute_path",
    "local_secret_path",
    "excluded_file_path",
    "live_configuration"
  ],
  "ownership_boundaries": {
    "current_host_transport": "codex-host",
    "legacy_profile_authority_only": true,
    "oauth_profile": "cstar-hub",
    "oauth_owner": "hermes",
    "forge_lane": "local_authorized_implementation",
    "researcher_lane": "local_authorized_evidence",
    "intake_changes_boundaries": false
  },
  "authority_grants": {
    "worker_enrollment": false,
    "source_authority": false,
    "execution": false,
    "spend": false,
    "provider_selection": false,
    "model_selection": false,
    "profile_mutation": false,
    "activation": false
  },
  "bundle_gate": {
    "operator_candidate_approval_required": true,
    "secret_and_private_data_scan_required": true,
    "manual_review_required": true,
    "archive_before_approval_allowed": false,
    "commit_before_approval_allowed": false,
    "upload_before_approval_allowed": false,
    "schema_grants_bundle_authority": false
  }
}
