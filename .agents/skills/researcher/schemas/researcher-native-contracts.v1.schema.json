{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cstar.researcher.native_contracts.v1",
  "title": "CStar Researcher native reconnection contracts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "cstar.researcher.native_contracts.v1" },
    "request": { "$ref": "#/$defs/request" },
    "authority_binding": { "$ref": "#/$defs/authority_binding" },
    "native_work_package": { "$ref": "#/$defs/native_work_package" },
    "terminal_receipt": { "$ref": "#/$defs/terminal_receipt" },
    "validation_subject": { "$ref": "#/$defs/validation_subject" },
    "validation_receipt": { "$ref": "#/$defs/validation_receipt" }
  },
  "required": ["schema"],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$" },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_model": { "const": "gpt-5.6-luna" },
        "requested_reasoning": { "const": "max" },
        "selector_status": { "const": "enforced" },
        "actual_identity": { "type": ["string", "null"] }
      },
      "required": ["requested_model", "requested_reasoning", "selector_status", "actual_identity"]
    },
    "counter_zero": { "const": 0 },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "cstar.researcher_request.v2" },
        "contract_version": { "const": "v2" },
        "bead_id": { "$ref": "#/$defs/id" },
        "set_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "source_callback_thread_id": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "research_questions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "target_spokes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "primary_requested_action": { "const": "report" },
        "target_paths": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "string", "minLength": 1 },
        "system_under_test": { "type": ["string", "null"] },
        "authority_lane": { "enum": ["green", "yellow", "red"] },
        "source_grants": { "type": "array", "items": { "type": "object" } },
        "source_budget": { "type": "object" },
        "spend_policy": { "type": "object" },
        "retry_policy": { "type": "object" },
        "selector": { "$ref": "#/$defs/selector" },
        "expected_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "metrics": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "prohibitions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "idempotency_key": { "type": "string", "minLength": 8 },
        "request_sha256": { "$ref": "#/$defs/digest" },
        "request_id": { "$ref": "#/$defs/id" }
      },
      "required": ["schema", "contract_version", "decision_id", "source_callback_thread_id", "objective", "research_questions", "target_spokes", "primary_requested_action", "scope", "authority_lane", "expected_artifacts", "metrics", "prohibitions", "selector", "request_sha256", "request_id"]
    },
    "authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "cstar.researcher_authority_binding.v1" },
        "request_id": { "$ref": "#/$defs/id" },
        "request_sha256": { "$ref": "#/$defs/digest" },
        "bead_id": { "$ref": "#/$defs/id" },
        "set_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "authorization_sha256": { "$ref": "#/$defs/digest" },
        "authorization_expires_at": { "type": "integer", "minimum": 0 },
        "one_use": { "const": true }
      },
      "required": ["schema", "request_id", "request_sha256", "bead_id", "set_id", "decision_id", "authorization_id", "authorization_sha256", "authorization_expires_at", "one_use"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "media_type": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "path", "sha256", "byte_count", "media_type"]
    },
    "native_work_package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "cstar.researcher_native_work_package.v1" },
        "request_id": { "$ref": "#/$defs/id" },
        "request_sha256": { "$ref": "#/$defs/digest" },
        "bead_id": { "$ref": "#/$defs/id" },
        "set_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "authorization_sha256": { "$ref": "#/$defs/digest" },
        "authorization_expires_at": { "type": "integer", "minimum": 0 },
        "attempt_id": { "$ref": "#/$defs/id" },
        "job_id": { "$ref": "#/$defs/id" },
        "idempotency_key": { "type": "string", "minLength": 8 },
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_sha256": { "$ref": "#/$defs/digest" },
        "selected_source_manifest_sha256": { "$ref": "#/$defs/digest" },
        "callable_policy_sha256": { "$ref": "#/$defs/digest" },
        "source_grants_sha256": { "$ref": "#/$defs/digest" },
        "source_budget_sha256": { "$ref": "#/$defs/digest" },
        "output_root": { "type": "string", "minLength": 1 },
        "expected_artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "selector": { "$ref": "#/$defs/selector" },
        "max_host_attempts": { "const": 1 },
        "max_descendants": { "const": 0 },
        "max_peer_messages": { "const": 0 },
        "max_retries": { "const": 0 },
        "max_replays": { "const": 0 },
        "max_fallbacks": { "const": 0 },
        "terminal_schema": { "const": "cstar.researcher_terminal_receipt.v1" }
      },
      "required": ["schema", "request_id", "request_sha256", "bead_id", "set_id", "decision_id", "authorization_id", "authorization_sha256", "authorization_expires_at", "attempt_id", "job_id", "idempotency_key", "adapter_id", "adapter_sha256", "selected_source_manifest_sha256", "callable_policy_sha256", "source_grants_sha256", "source_budget_sha256", "output_root", "expected_artifacts", "selector", "max_host_attempts", "max_descendants", "max_peer_messages", "max_retries", "max_replays", "max_fallbacks", "terminal_schema"]
    },
    "terminal_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "cstar.researcher_terminal_receipt.v1" },
        "request_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "job_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["DELIVERED_UNVERIFIED", "REJECTED", "UNKNOWN"] },
        "selector": { "$ref": "#/$defs/selector" },
        "native_worker_attempts": { "const": 1 },
        "descendants": { "$ref": "#/$defs/counter_zero" },
        "peer_messages": { "$ref": "#/$defs/counter_zero" },
        "retries": { "$ref": "#/$defs/counter_zero" },
        "replays": { "$ref": "#/$defs/counter_zero" },
        "fallbacks": { "$ref": "#/$defs/counter_zero" },
        "hermes_transport_calls": { "$ref": "#/$defs/counter_zero" },
        "legacy_hermes_subprocess_calls": { "$ref": "#/$defs/counter_zero" }
      },
      "required": ["schema", "request_id", "attempt_id", "job_id", "status", "selector", "native_worker_attempts", "descendants", "peer_messages", "retries", "replays", "fallbacks", "hermes_transport_calls", "legacy_hermes_subprocess_calls"]
    },
    "validation_subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "cstar.researcher_validation_subject.v1" },
        "subject_kind": { "const": "researcher_execution" },
        "request_id": { "$ref": "#/$defs/id" },
        "request_sha256": { "$ref": "#/$defs/digest" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "job_id": { "$ref": "#/$defs/id" },
        "work_package_sha256": { "$ref": "#/$defs/digest" },
        "handoff_sha256": { "$ref": "#/$defs/digest" },
        "terminal_receipt_sha256": { "$ref": "#/$defs/digest" },
        "one_use": { "const": true },
        "validator_identity": { "type": "string", "minLength": 1 }
      },
      "required": ["schema", "subject_kind", "request_id", "request_sha256", "attempt_id", "job_id", "work_package_sha256", "handoff_sha256", "terminal_receipt_sha256", "one_use", "validator_identity"]
    },
    "validation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "cstar.researcher_validation_receipt.v1" },
        "subject": { "$ref": "#/$defs/validation_subject" },
        "verdict": { "enum": ["ACCEPTED", "REJECTED", "INCONCLUSIVE"] },
        "manifest_sha256": { "$ref": "#/$defs/digest" },
        "recorded": { "type": "boolean" }
      },
      "required": ["schema", "subject", "verdict", "manifest_sha256", "recorded"]
    }
  }
}
