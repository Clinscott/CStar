{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cstar.researcher.native.contracts.v1",
  "title": "CStar native Researcher contracts",
  "description": "Strict hash-bound request, handoff, completion, and validation envelopes. Actual host identity remains unreported until attested.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version"],
  "properties": {
    "schema": {
      "enum": [
        "cstar.researcher_request.v2",
        "cstar.researcher_authority_binding.v1",
        "cstar.researcher_native_work_package.v1",
        "cstar.researcher_native_host_worker_handoff.v1",
        "cstar.researcher_host_completion.v1",
        "cstar.researcher_terminal_receipt.v1",
        "cstar.researcher_validation_subject.v1",
        "cstar.researcher_validation_receipt.v1",
        "cstar.researcher_validation_binding.v1"
      ]
    },
    "contract_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "request_id": {"$ref": "#/$defs/id"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "job_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "handoff_sha256": {"$ref": "#/$defs/sha256"},
    "output_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_sha256": {"$ref": "#/$defs/sha256"},
    "selected_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "callable_policy_sha256": {"$ref": "#/$defs/sha256"},
    "source_grants_sha256": {"$ref": "#/$defs/sha256"},
    "source_budget_sha256": {"$ref": "#/$defs/sha256"},
    "requested_model": {"const": "gpt-5.6-luna"},
    "requested_reasoning": {"const": "max"},
    "selector_status": {"const": "enforced"},
    "actual_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "one_use": {"const": true},
    "max_host_attempts": {"const": 1},
    "max_descendants": {"const": 0},
    "max_peer_messages": {"const": 0},
    "max_retries": {"const": 0},
    "max_replays": {"const": 0},
    "max_fallbacks": {"const": 0}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_model", "requested_reasoning", "selector_status", "actual_identity"],
      "properties": {
        "requested_model": {"const": "gpt-5.6-luna"},
        "requested_reasoning": {"const": "max"},
        "selector_status": {"const": "enforced"},
        "actual_identity": {"type": "string", "minLength": 1}
      }
    },
    "adapter_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "adapter_sha256", "selected_source_manifest_sha256", "callable_policy_sha256"],
      "properties": {
        "adapter_id": {"const": "cstar.researcher_preserved_adapter.v1"},
        "adapter_sha256": {"$ref": "#/$defs/sha256"},
        "selected_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "callable_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "zero_limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_host_attempts": {"const": 1},
        "max_descendants": {"const": 0},
        "max_peer_messages": {"const": 0},
        "max_retries": {"const": 0},
        "max_replays": {"const": 0},
        "max_fallbacks": {"const": 0}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "name", "artifact_kind"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_kind": {"enum": ["report", "package", "test_result", "other"]}
      }
    },
    "artifact_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "artifacts", "total_bytes"],
      "properties": {
        "schema": {"const": "cstar.researcher_artifact_manifest.v1"},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/artifact"}},
        "total_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "terminal_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "request_id", "request_sha256", "job_id", "attempt_id", "host_task_id", "outcome", "requested_model", "requested_reasoning", "selector_status", "actual_identity", "worker_attempts_started", "worker_attempts_terminal", "provider_requests_started", "source_tool_calls", "retries", "replays", "fallbacks", "descendants", "peer_messages", "output_manifest_sha256", "adapter_sha256", "selected_source_manifest_sha256", "callable_policy_sha256", "source_grants_sha256", "source_budget_sha256", "observed_at", "elapsed_ms"],
      "properties": {
        "schema": {"const": "cstar.researcher_terminal_receipt.v1"},
        "request_id": {"$ref": "#/$defs/id"}, "request_sha256": {"$ref": "#/$defs/sha256"},
        "job_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
        "host_task_id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["DELIVERED_UNVERIFIED", "REJECTED", "UNKNOWN"]},
        "requested_model": {"const": "gpt-5.6-luna"}, "requested_reasoning": {"const": "max"}, "selector_status": {"const": "enforced"},
        "actual_identity": {"type": "string", "minLength": 1},
        "worker_attempts_started": {"const": 1}, "worker_attempts_terminal": {"const": 1},
        "provider_requests_started": {"type": "integer", "minimum": 0, "maximum": 1}, "source_tool_calls": {"type": "integer", "minimum": 0},
        "retries": {"const": 0}, "replays": {"const": 0}, "fallbacks": {"const": 0}, "descendants": {"const": 0}, "peer_messages": {"const": 0},
        "output_manifest_sha256": {"$ref": "#/$defs/sha256"}, "adapter_sha256": {"$ref": "#/$defs/sha256"},
        "selected_source_manifest_sha256": {"$ref": "#/$defs/sha256"}, "callable_policy_sha256": {"$ref": "#/$defs/sha256"},
        "source_grants_sha256": {"$ref": "#/$defs/sha256"}, "source_budget_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at": {"type": "integer", "minimum": 0}, "elapsed_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
